<UserControl x:Class="SM3DiagTool.Views.FlashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="Flash / Pamiec ECU" FontSize="22" FontWeight="Bold"
                   Foreground="#007ACC" Margin="0,0,0,12"/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Adres:" Foreground="#888" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Text="{Binding MemoryAddressHex}" Width="100" Background="#2D2D30"
                     Foreground="#4EC9B0" BorderBrush="#3E3E42" FontFamily="Consolas" Padding="4" Margin="0,0,12,0"/>
            <TextBlock Text="Rozmiar:" Foreground="#888" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Text="{Binding MemorySizeHex}" Width="100" Background="#2D2D30"
                     Foreground="#4EC9B0" BorderBrush="#3E3E42" FontFamily="Consolas" Padding="4" Margin="0,0,12,0"/>
            <Button Content="Odczytaj" Command="{Binding ReadMemoryCommand}" Style="{StaticResource ActionButton}"/>
            <Button Content="Zapisz" Command="{Binding WriteMemoryCommand}" Style="{StaticResource DangerButton}"/>
            <Button Content="Kasuj" Command="{Binding EraseMemoryCommand}" Style="{StaticResource DangerButton}"/>
            <Button Content="Zapisz do pliku" Command="{Binding SaveToFileCommand}" Style="{StaticResource ActionButton}"/>
            <Button Content="Wczytaj z pliku" Command="{Binding LoadFromFileCommand}" Style="{StaticResource ActionButton}"/>
        </StackPanel>

        <ProgressBar DockPanel.Dock="Top" Value="{Binding Progress}" Maximum="{Binding ProgressMax}"
                     Height="8" Margin="0,0,0,8" Background="#3E3E42" Foreground="#007ACC"/>

        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" Foreground="#888" FontSize="12" Margin="4,0,0,8"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Text="{Binding HexDump}" Background="#0C0C0C" Foreground="#4EC9B0"
                     BorderBrush="#3E3E42" FontFamily="Consolas" FontSize="12" IsReadOnly="False"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Margin="0,0,8,0"/>

            <ListBox Grid.Column="1" ItemsSource="{Binding Log}" Background="#1E1E1E"
                     BorderBrush="#3E3E42" Foreground="#888" FontFamily="Consolas" FontSize="10"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </Grid>
    </DockPanel>
</UserControl>
